    <DTS:Executable
      DTS:refId="Package\03 - Validate Data Guide Load"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1FDC53E8-D117-4F27-B218-F1669BEF824C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="03 - Validate Data Guide Load"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;DECLARE @RowsRead BIGINT = ?;&#xA;&#xA;DECLARE @RowsLoaded BIGINT =&#xA;(&#xA;    SELECT COUNT_BIG(*)&#xA;    FROM stg.DataGuideRaw&#xA;);&#xA;&#xA;IF @RowsRead = 0&#xA;    THROW 51001, N'SSIS không đọc được Data Guide.', 1;&#xA;&#xA;IF @RowsRead &lt;&gt; @RowsLoaded&#xA;    THROW 51002, N'Số dòng đọc khác số dòng đã nạp.', 1;&#xA;&#xA;IF @RowsLoaded &lt;&gt; 1821&#xA;    THROW 51003, N'Data Guide không có đúng 1821 dòng.', 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::v_DataGuideRowCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\04 - Build Code Lookup"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E4726FD9-2E95-4C0E-B3E9-45C2CBFE484B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="04 - Build Code Lookup"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF OBJECT_ID(N'stg.CodeLookup', N'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE stg.CodeLookup&#xA;    (&#xA;        CodeLookupKey INT IDENTITY(1,1) NOT NULL&#xA;            CONSTRAINT PK_CodeLookup PRIMARY KEY,&#xA;&#xA;        SourceTable NVARCHAR(100) NOT NULL,&#xA;        FieldName NVARCHAR(200) NOT NULL,&#xA;        RawCode NVARCHAR(200) NOT NULL,&#xA;        Label NVARCHAR(500) NOT NULL,&#xA;        Note NVARCHAR(2000) NULL,&#xA;&#xA;        CONSTRAINT UQ_CodeLookup&#xA;            UNIQUE (SourceTable, FieldName, RawCode)&#xA;    );&#xA;END;&#xA;&#xA;TRUNCATE TABLE stg.CodeLookup;&#xA;&#xA;INSERT INTO stg.CodeLookup&#xA;(&#xA;    SourceTable, FieldName, RawCode, Label, Note&#xA;)&#xA;SELECT DISTINCT&#xA;    LTRIM(RTRIM(SourceTable)),&#xA;    LTRIM(RTRIM(FieldName)),&#xA;    LTRIM(RTRIM(RawCode)),&#xA;    LTRIM(RTRIM(Label)),&#xA;    NULLIF(LTRIM(RTRIM(Note)), N'')&#xA;FROM stg.DataGuideRaw&#xA;WHERE NULLIF(LTRIM(RTRIM(SourceTable)), N'') IS NOT NULL&#xA;  AND NULLIF(LTRIM(RTRIM(FieldName)), N'') IS NOT NULL&#xA;  AND NULLIF(LTRIM(RTRIM(RawCode)), N'') IS NOT NULL&#xA;  AND NULLIF(LTRIM(RTRIM(Label)), N'') IS NOT NULL;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM stg.CodeLookup) &lt;&gt; 1774&#xA;    THROW 51004, N'Số mapping hợp lệ không bằng 1774.', 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\05 - Supplement ONS and Validate Lookup"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C00AF234-726C-4B0D-8948-51DB7E3DD8A4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="05 - Supplement ONS and Validate Lookup"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO stg.CodeLookup&#xA;(&#xA;    SourceTable, FieldName, RawCode, Label, Note&#xA;)&#xA;SELECT&#xA;    N'collision',&#xA;    N'local_authority_ons_district',&#xA;    S.RawCode,&#xA;    S.Label,&#xA;    N'Mapping bổ sung của phiên bản hiện tại.'&#xA;FROM&#xA;(&#xA;    VALUES&#xA;        (N'E07000246', N'Somerset West and Taunton'),&#xA;        (N'E08000038', N'Barnsley'),&#xA;        (N'E08000039', N'Sheffield')&#xA;) AS S(RawCode, Label)&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM stg.CodeLookup AS L&#xA;    WHERE L.SourceTable = N'collision'&#xA;      AND L.FieldName = N'local_authority_ons_district'&#xA;      AND L.RawCode = S.RawCode&#xA;);&#xA;&#xA;IF&#xA;(&#xA;    SELECT COUNT_BIG(*)&#xA;    FROM stg.CodeLookup AS L&#xA;    INNER JOIN&#xA;    (&#xA;        VALUES&#xA;            (N'E07000246', N'Somerset West and Taunton'),&#xA;            (N'E08000038', N'Barnsley'),&#xA;            (N'E08000039', N'Sheffield')&#xA;    ) AS S(RawCode, Label)&#xA;        ON S.RawCode = L.RawCode&#xA;       AND S.Label = L.Label&#xA;    WHERE L.SourceTable = N'collision'&#xA;      AND L.FieldName = N'local_authority_ons_district'&#xA;) &lt;&gt; 3&#xA;    THROW 51005, N'Mapping ONS bổ sung chưa đầy đủ.', 1;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM stg.CodeLookup) &lt;&gt; 1777&#xA;    THROW 51006, N'Tổng số mapping không bằng 1777.', 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
