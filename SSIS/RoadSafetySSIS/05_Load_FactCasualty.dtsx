      DTS:DTSID="{88340592-528A-47C6-9D86-466D98ED695D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="01 - Validate Fact Sources"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM stg.Collisions) &lt;&gt; 513801&#xA;    THROW 53001, N'Stg Collisions chưa đủ dữ liệu.', 1;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM stg.Vehicles) &lt;&gt; 937265&#xA;    THROW 53002, N'Stg Vehicles chưa đủ dữ liệu.', 1;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM stg.Casualties) &lt;&gt; 652821&#xA;    THROW 53003, N'Stg Casualties chưa đủ dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimDate)&#xA;    THROW 53004, N'DimDate rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimTime)&#xA;    THROW 53005, N'DimTime rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimLocation)&#xA;    THROW 53006, N'DimLocation rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimRoad)&#xA;    THROW 53007, N'DimRoad rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimJunction)&#xA;    THROW 53008, N'DimJunction rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimEnvironment)&#xA;    THROW 53009, N'DimEnvironment rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimVehicle)&#xA;    THROW 53010, N'DimVehicle rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimDriver)&#xA;    THROW 53011, N'DimDriver rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimCasualty)&#xA;    THROW 53012, N'DimCasualty rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimCollisionSeverity)&#xA;    THROW 53013, N'DimCollisionSeverity rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimCasualtySeverity)&#xA;    THROW 53014, N'DimCasualtySeverity rỗng.', 1;&#xA;&#xA;IF EXISTS (SELECT 1 FROM dwh.FactCasualty)&#xA;    THROW 53015, N'Fact chưa được dọn trước khi nạp.', 1;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
