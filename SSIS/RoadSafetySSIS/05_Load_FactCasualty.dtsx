    <DTS:Executable
      DTS:refId="Package\03 - Validate FactCasualty"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A0DEC7EF-0D82-48B0-8FBD-AA788876887D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="03 - Validate FactCasualty"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;DECLARE @SSISRows BIGINT = ?;&#xA;&#xA;DECLARE @FactRows BIGINT;&#xA;DECLARE @Collisions BIGINT;&#xA;DECLARE @Vehicles BIGINT;&#xA;DECLARE @ActualKSI BIGINT;&#xA;DECLARE @ExpectedKSI BIGINT;&#xA;DECLARE @MismatchRows BIGINT;&#xA;&#xA;/* 1. Tổng hợp các chỉ số từ Fact */&#xA;&#xA;SELECT&#xA;    @FactRows = COUNT_BIG(*),&#xA;    @Collisions = COUNT_BIG(DISTINCT CollisionIndex),&#xA;    @Vehicles = COUNT_BIG(DISTINCT VehicleInvolvementID),&#xA;    @ActualKSI = SUM(CONVERT(BIGINT, KSICasualtyCount))&#xA;FROM dwh.FactCasualty;&#xA;&#xA;/* 2. Kiểm tra số dòng đi qua Row Count */&#xA;&#xA;IF @SSISRows IS NULL OR @SSISRows &lt;&gt; 652821&#xA;    THROW 54001, N'Row Count SSIS không bằng 652821.', 1;&#xA;&#xA;/* 3. Đối chiếu số dòng Fact với Row Count */&#xA;&#xA;IF @FactRows &lt;&gt; 652821 OR @FactRows &lt;&gt; @SSISRows&#xA;    THROW 54002, N'Số dòng Fact không khớp.', 1;&#xA;&#xA;/* 4. Kiểm tra số vụ va chạm phân biệt */&#xA;&#xA;IF @Collisions &lt;&gt; 513801&#xA;    THROW 54003, N'Số collision phân biệt không đúng.', 1;&#xA;&#xA;/* 5. Kiểm tra số phương tiện gắn với người thương vong */&#xA;&#xA;IF @Vehicles &lt;&gt; 566945&#xA;    THROW 54004, N'Số vehicle gắn casualty không đúng.', 1;&#xA;&#xA;/* 6. Kiểm tra trùng mức chi tiết */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT&#xA;        CollisionIndex,&#xA;        CasualtyReference&#xA;    FROM dwh.FactCasualty&#xA;    GROUP BY&#xA;        CollisionIndex,&#xA;        CasualtyReference&#xA;    HAVING COUNT_BIG(*) &gt; 1&#xA;)&#xA;    THROW 54005, N'Fact bị trùng grain.', 1;&#xA;&#xA;/* 7. Kiểm tra khóa Dimension bị NULL */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactCasualty&#xA;    WHERE DateKey IS NULL&#xA;       OR TimeKey IS NULL&#xA;       OR LocationKey IS NULL&#xA;       OR RoadKey IS NULL&#xA;       OR JunctionKey IS NULL&#xA;       OR EnvironmentKey IS NULL&#xA;       OR CollisionSeverityKey IS NULL&#xA;       OR VehicleKey IS NULL&#xA;       OR DriverKey IS NULL&#xA;       OR CasualtyKey IS NULL&#xA;       OR CasualtySeverityKey IS NULL&#xA;)&#xA;    THROW 54006, N'Fact có Dimension Key NULL.', 1;&#xA;&#xA;/* 8. Kiểm tra giá trị các chỉ số */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactCasualty&#xA;    WHERE CasualtyCount IS NULL&#xA;       OR CasualtyCount &lt;&gt; 1&#xA;       OR KSICasualtyCount IS NULL&#xA;       OR KSICasualtyCount NOT IN (0, 1)&#xA;)&#xA;    THROW 54007, N'Measure không hợp lệ.', 1;&#xA;&#xA;/* 9. Tính tổng KSI kỳ vọng từ Staging */&#xA;&#xA;SELECT&#xA;    @ExpectedKSI =&#xA;        SUM(&#xA;            CASE&#xA;                WHEN casualty_severity IN (N'Fatal', N'Serious')&#xA;                    THEN CONVERT(BIGINT, 1)&#xA;                ELSE CONVERT(BIGINT, 0)&#xA;            END&#xA;        )&#xA;FROM stg.Casualties;&#xA;&#xA;IF @ActualKSI IS NULL&#xA;   OR @ExpectedKSI IS NULL&#xA;   OR @ActualKSI &lt;&gt; @ExpectedKSI&#xA;    THROW 54008, N'Tổng KSI không khớp staging.', 1;&#xA;&#xA;/* 10. Đối chiếu phương tiện và KSI trên từng dòng&#xA;       Đây là đoạn đã tối ưu so với phiên bản trước. */&#xA;&#xA;SELECT&#xA;    @MismatchRows = COUNT_BIG(*)&#xA;FROM dwh.FactCasualty AS F&#xA;INNER JOIN stg.Casualties AS C&#xA;    ON C.collision_index = F.CollisionIndex&#xA;   AND C.casualty_reference = F.CasualtyReference&#xA;WHERE F.VehicleReference &lt;&gt; C.vehicle_reference&#xA;   OR F.KSICasualtyCount &lt;&gt;&#xA;      CASE&#xA;          WHEN C.casualty_severity IN (N'Fatal', N'Serious')&#xA;              THEN 1&#xA;          ELSE 0&#xA;      END&#xA;OPTION (HASH JOIN, RECOMPILE);&#xA;&#xA;IF @MismatchRows &gt; 0&#xA;    THROW 54009, N'Fact sai vehicle hoặc KSI so với nguồn.', 1;&#xA;&#xA;/* 11. Kiểm tra tọa độ thiếu theo cặp */&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactCasualty&#xA;    WHERE (Longitude IS NULL AND Latitude IS NOT NULL)&#xA;       OR (Longitude IS NOT NULL AND Latitude IS NULL)&#xA;)&#xA;    THROW 54010, N'Tọa độ không thiếu theo cặp.', 1;&#xA;&#xA;/* 12. Kiểm tra số vụ va chạm thiếu tọa độ */&#xA;&#xA;IF&#xA;(&#xA;    SELECT COUNT_BIG(DISTINCT CollisionIndex)&#xA;    FROM dwh.FactCasualty&#xA;    WHERE Longitude IS NULL&#xA;      AND Latitude IS NULL&#xA;) &lt;&gt; 53&#xA;    THROW 54011, N'Số collision thiếu tọa độ không bằng 53.', 1;&#xA;&#xA;PRINT N'PASS — Kiểm tra FactCasualty hoàn tất.';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::v_FactCasualtyRowCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
