                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    D.DateKey,
    T.TimeKey,
    L.LocationKey,
    R.RoadKey,
    J.JunctionKey,
    E.EnvironmentKey,
    CS.CollisionSeverityKey,
    VD.VehicleKey,
    DD.DriverKey,
    CD.CasualtyKey,
    CAS.CasualtySeverityKey,

    C.collision_index AS CollisionIndex,
    CA.vehicle_reference AS VehicleReference,
    CA.casualty_reference AS CasualtyReference,

    CAST(
        CONCAT(CA.collision_index, '-', CA.vehicle_reference)
        AS VARCHAR(100)
    ) AS VehicleInvolvementID,

    TRY_CONVERT(
        DECIMAL(9,6),
        NULLIF(LTRIM(RTRIM(C.longitude)), '')
    ) AS Longitude,

    TRY_CONVERT(
        DECIMAL(9,6),
        NULLIF(LTRIM(RTRIM(C.latitude)), '')
    ) AS Latitude,

    CAST(1 AS TINYINT) AS CasualtyCount,

    CAST(
        CASE
            WHEN CA.casualty_severity IN (N'Fatal', N'Serious')
                THEN 1
            ELSE 0
        END AS TINYINT
    ) AS KSICasualtyCount

FROM stg.Casualties AS CA

INNER JOIN stg.Collisions AS C
    ON C.collision_index = CA.collision_index

INNER JOIN stg.Vehicles AS V
    ON V.collision_index = CA.collision_index
   AND V.vehicle_reference = CA.vehicle_reference

INNER JOIN dwh.DimDate AS D
    ON D.FullDate = C.[date]

INNER JOIN dwh.DimTime AS T
    ON T.FullTime = C.[time]

INNER JOIN dwh.DimLocation AS L
    ON L.LocalAuthorityCode = C.local_authority_ons_district

INNER JOIN dwh.DimRoad AS R
    ON R.FirstRoadClass = C.first_road_class
   AND R.RoadType = C.road_type
   AND ISNULL(R.SpeedLimit, -32768) =
       ISNULL(
           TRY_CONVERT(
               SMALLINT,
               NULLIF(LTRIM(RTRIM(C.speed_limit)), '')
           ),
           -32768
       )
   AND R.UrbanOrRuralArea = C.urban_or_rural_area

INNER JOIN dwh.DimJunction AS J
    ON J.JunctionDetail = C.junction_detail
   AND J.JunctionControl = C.junction_control
   AND J.PedestrianCrossing = C.pedestrian_crossing

INNER JOIN dwh.DimEnvironment AS E
    ON E.LightConditions = C.light_conditions
   AND E.WeatherConditions = C.weather_conditions
   AND E.RoadSurfaceConditions = C.road_surface_conditions

INNER JOIN dwh.DimCollisionSeverity AS CS
    ON CS.CollisionSeverity = C.collision_severity

INNER JOIN dwh.DimVehicle AS VD
    ON VD.VehicleType = V.vehicle_type
   AND VD.VehicleManoeuvre = V.vehicle_manoeuvre
   AND VD.SkiddingAndOverturning = V.skidding_and_overturning
   AND VD.VehicleLeavingCarriageway = V.vehicle_leaving_carriageway

INNER JOIN dwh.DimDriver AS DD
    ON DD.SexOfDriver = V.sex_of_driver
   AND DD.AgeBandOfDriver = V.age_band_of_driver

INNER JOIN dwh.DimCasualty AS CD
    ON CD.CasualtyClass = CA.casualty_class
   AND CD.SexOfCasualty = CA.sex_of_casualty
   AND CD.AgeBandOfCasualty = CA.age_band_of_casualty
   AND CD.CasualtyType = CA.casualty_type

INNER JOIN dwh.DimCasualtySeverity AS CAS
    ON CAS.CasualtySeverity = CA.casualty_severity;</property>
