  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\01 - Clear Fact and Dimensions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9D4BDEC7-7B32-4A29-A54F-77C31B4ECAB1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="01 - Clear Fact and Dimensions"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    TRUNCATE TABLE dwh.FactCasualty;&#xA;&#xA;    DELETE FROM dwh.DimCasualtySeverity;&#xA;    DELETE FROM dwh.DimCollisionSeverity;&#xA;    DELETE FROM dwh.DimCasualty;&#xA;    DELETE FROM dwh.DimDriver;&#xA;    DELETE FROM dwh.DimVehicle;&#xA;    DELETE FROM dwh.DimEnvironment;&#xA;    DELETE FROM dwh.DimJunction;&#xA;    DELETE FROM dwh.DimRoad;&#xA;    DELETE FROM dwh.DimLocation;&#xA;    DELETE FROM dwh.DimTime;&#xA;    DELETE FROM dwh.DimDate;&#xA;&#xA;    DBCC CHECKIDENT ('dwh.DimLocation', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimRoad', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimJunction', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimEnvironment', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimVehicle', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimDriver', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimCasualty', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimCollisionSeverity', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimCasualtySeverity', RESEED, 0);&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;END CATCH;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\02 - Load DimDate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0ecf858a-9a02-466e-b8ff-0b14a502489d}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="02 - Load DimDate"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET LANGUAGE us_english;&#xA;SET DATEFIRST 1;&#xA;&#xA;DECLARE @StartDate DATE = DATEFROMPARTS(2021, 1, 1);&#xA;DECLARE @EndDate DATE = DATEFROMPARTS(2025, 12, 31);&#xA;&#xA;;WITH DateSeries AS&#xA;(&#xA;    SELECT @StartDate AS FullDate&#xA;&#xA;    UNION ALL&#xA;&#xA;    SELECT DATEADD(DAY, 1, FullDate)&#xA;    FROM DateSeries&#xA;    WHERE FullDate &lt; @EndDate&#xA;)&#xA;INSERT INTO dwh.DimDate&#xA;(&#xA;    DateKey,&#xA;    FullDate,&#xA;    [Day],&#xA;    MonthNumber,&#xA;    MonthName,&#xA;    [Quarter],&#xA;    [Year],&#xA;    DayOfWeekNumber,&#xA;    DayOfWeekName,&#xA;    IsWeekend&#xA;)&#xA;SELECT&#xA;    CONVERT(INT, CONVERT(CHAR(8), FullDate, 112)),&#xA;    FullDate,&#xA;    DATEPART(DAY, FullDate),&#xA;    DATEPART(MONTH, FullDate),&#xA;    DATENAME(MONTH, FullDate),&#xA;    DATEPART(QUARTER, FullDate),&#xA;    DATEPART(YEAR, FullDate),&#xA;    DATEPART(WEEKDAY, FullDate),&#xA;    DATENAME(WEEKDAY, FullDate),&#xA;    CAST(&#xA;        CASE&#xA;            WHEN DATEPART(WEEKDAY, FullDate) IN (6, 7)&#xA;                THEN 1&#xA;            ELSE 0&#xA;        END AS BIT&#xA;    )&#xA;FROM DateSeries&#xA;OPTION (MAXRECURSION 0);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\03 - Load DimTime"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{76dd1f5f-e672-4bd7-9ad6-4ad818b1c3fa}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="03 - Load DimTime"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;;WITH MinuteSeries AS&#xA;(&#xA;    SELECT 0 AS MinuteOfDay&#xA;&#xA;    UNION ALL&#xA;&#xA;    SELECT MinuteOfDay + 1&#xA;    FROM MinuteSeries&#xA;    WHERE MinuteOfDay &lt; 1439&#xA;)&#xA;INSERT INTO dwh.DimTime&#xA;(&#xA;    TimeKey,&#xA;    FullTime,&#xA;    [Hour],&#xA;    [Minute],&#xA;    TimeBand&#xA;)&#xA;SELECT&#xA;    (MinuteOfDay / 60) * 100 + MinuteOfDay % 60,&#xA;    TIMEFROMPARTS(&#xA;        MinuteOfDay / 60,&#xA;        MinuteOfDay % 60,&#xA;        0, 0, 0&#xA;    ),&#xA;    MinuteOfDay / 60,&#xA;    MinuteOfDay % 60,&#xA;    CASE&#xA;        WHEN MinuteOfDay / 60 BETWEEN 0 AND 5&#xA;            THEN N'Night'&#xA;        WHEN MinuteOfDay / 60 BETWEEN 6 AND 11&#xA;            THEN N'Morning'&#xA;        WHEN MinuteOfDay / 60 BETWEEN 12 AND 17&#xA;            THEN N'Afternoon'&#xA;        ELSE N'Evening'&#xA;    END&#xA;FROM MinuteSeries&#xA;OPTION (MAXRECURSION 0);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\04 - Load DimLocation"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4334981e-c938-431c-9965-de57a80c2331}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="04 - Load DimLocation"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimLocation&#xA;(&#xA;    LocalAuthorityCode,&#xA;    LocalAuthorityName&#xA;)&#xA;SELECT DISTINCT&#xA;    local_authority_ons_district,&#xA;    local_authority_ons_district_name&#xA;FROM stg.Collisions;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\05 - Load DimRoad"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{95d2baf8-61c7-4053-8f49-b7c74c19331e}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="05 - Load DimRoad"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimRoad&#xA;(&#xA;    FirstRoadClass,&#xA;    RoadType,&#xA;    SpeedLimit,&#xA;    UrbanOrRuralArea&#xA;)&#xA;SELECT DISTINCT&#xA;    first_road_class,&#xA;    road_type,&#xA;    TRY_CONVERT(&#xA;        SMALLINT,&#xA;        NULLIF(LTRIM(RTRIM(speed_limit)), '')&#xA;    ),&#xA;    urban_or_rural_area&#xA;FROM stg.Collisions;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\06 - Load DimJunction"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5146f67a-46ad-4399-b08d-fdb8a5f49a5a}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="06 - Load DimJunction"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimJunction&#xA;(&#xA;    JunctionDetail,&#xA;    JunctionControl,&#xA;    PedestrianCrossing&#xA;)&#xA;SELECT DISTINCT&#xA;    junction_detail,&#xA;    junction_control,&#xA;    pedestrian_crossing&#xA;FROM stg.Collisions;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\07 - Load DimEnvironment"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{b2bf6163-a697-42a7-9b5f-40e38ac69729}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="07 - Load DimEnvironment"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimEnvironment&#xA;(&#xA;    LightConditions,&#xA;    WeatherConditions,&#xA;    RoadSurfaceConditions&#xA;)&#xA;SELECT DISTINCT&#xA;    light_conditions,&#xA;    weather_conditions,&#xA;    road_surface_conditions&#xA;FROM stg.Collisions;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\08 - Load DimVehicle"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{69e2e74e-f79e-46e2-bdbf-328fc764693b}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="08 - Load DimVehicle"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimVehicle&#xA;(&#xA;    VehicleType,&#xA;    VehicleManoeuvre,&#xA;    SkiddingAndOverturning,&#xA;    VehicleLeavingCarriageway&#xA;)&#xA;SELECT DISTINCT&#xA;    V.vehicle_type,&#xA;    V.vehicle_manoeuvre,&#xA;    V.skidding_and_overturning,&#xA;    V.vehicle_leaving_carriageway&#xA;FROM stg.Vehicles AS V&#xA;INNER JOIN stg.Casualties AS C&#xA;    ON C.collision_index = V.collision_index&#xA;   AND C.vehicle_reference = V.vehicle_reference;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\09 - Load DimDriver"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{540e0752-84b9-495e-b0dc-a7943fcd4262}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="09 - Load DimDriver"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimDriver&#xA;(&#xA;    SexOfDriver,&#xA;    AgeBandOfDriver&#xA;)&#xA;SELECT DISTINCT&#xA;    V.sex_of_driver,&#xA;    V.age_band_of_driver&#xA;FROM stg.Vehicles AS V&#xA;INNER JOIN stg.Casualties AS C&#xA;    ON C.collision_index = V.collision_index&#xA;   AND C.vehicle_reference = V.vehicle_reference;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\10 - Load DimCasualty"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{ba09e6d7-3eb3-4b4d-b0a4-e200acfddf85}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="10 - Load DimCasualty"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimCasualty&#xA;(&#xA;    CasualtyClass,&#xA;    SexOfCasualty,&#xA;    AgeBandOfCasualty,&#xA;    CasualtyType&#xA;)&#xA;SELECT DISTINCT&#xA;    casualty_class,&#xA;    sex_of_casualty,&#xA;    age_band_of_casualty,&#xA;    casualty_type&#xA;FROM stg.Casualties;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\11 - Load DimCollisionSeverity"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8a7d6fb4-8f13-4efb-b16c-12d81aaffa66}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="11 - Load DimCollisionSeverity"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimCollisionSeverity&#xA;(&#xA;    CollisionSeverity,&#xA;    CollisionSeverityGroup&#xA;)&#xA;SELECT DISTINCT&#xA;    collision_severity,&#xA;    CASE&#xA;        WHEN collision_severity IN (N'Fatal', N'Serious')&#xA;            THEN N'KSI'&#xA;        WHEN collision_severity = N'Slight'&#xA;            THEN N'Non-KSI'&#xA;        ELSE N'Unknown'&#xA;    END&#xA;FROM stg.Collisions;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\12 - Load DimCasualtySeverity"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{e70ba643-0b1b-4eaf-836d-b5df7c04cd9a}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="12 - Load DimCasualtySeverity"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimCasualtySeverity&#xA;(&#xA;    CasualtySeverity,&#xA;    CasualtySeverityGroup&#xA;)&#xA;SELECT DISTINCT&#xA;    casualty_severity,&#xA;    CASE&#xA;        WHEN casualty_severity IN (N'Fatal', N'Serious')&#xA;            THEN N'KSI'&#xA;        WHEN casualty_severity = N'Slight'&#xA;            THEN N'Non-KSI'&#xA;        ELSE N'Unknown'&#xA;    END&#xA;FROM stg.Casualties;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\13 - Validate Dimensions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{e622a10f-c78f-4a63-b8c0-f472922f23ea}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="13 - Validate Dimensions"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{860D2A57-9866-4977-8AC8-B7A012D2E50F}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM dwh.DimDate) &lt;&gt; 1826&#xA;    THROW 52001, N'DimDate không có đúng 1826 dòng.', 1;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM dwh.DimTime) &lt;&gt; 1440&#xA;    THROW 52002, N'DimTime không có đúng 1440 dòng.', 1;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM dwh.DimLocation) &lt;&gt; 370&#xA;    THROW 52003, N'DimLocation không có đúng 370 dòng.', 1;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM dwh.DimCollisionSeverity) &lt;&gt; 3&#xA;    THROW 52004, N'DimCollisionSeverity không có đúng 3 dòng.', 1;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM dwh.DimCasualtySeverity) &lt;&gt; 3&#xA;    THROW 52005, N'DimCasualtySeverity không có đúng 3 dòng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimRoad)&#xA;    THROW 52006, N'DimRoad rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimJunction)&#xA;    THROW 52007, N'DimJunction rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimEnvironment)&#xA;    THROW 52008, N'DimEnvironment rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimVehicle)&#xA;    THROW 52009, N'DimVehicle rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimDriver)&#xA;    THROW 52010, N'DimDriver rỗng.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimCasualty)&#xA;    THROW 52011, N'DimCasualty rỗng.', 1;&#xA;&#xA;IF&#xA;(&#xA;    (SELECT MIN(FullDate) FROM dwh.DimDate)&#xA;        &lt;&gt; DATEFROMPARTS(2021, 1, 1)&#xA;    OR&#xA;    (SELECT MAX(FullDate) FROM dwh.DimDate)&#xA;        &lt;&gt; DATEFROMPARTS(2025, 12, 31)&#xA;)&#xA;    THROW 52012, N'Phạm vi ngày không đúng.', 1;&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.DimTime&#xA;    WHERE TimeKey = 0&#xA;      AND FullTime = CAST('00:00:00' AS TIME(0))&#xA;)&#xA;OR NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.DimTime&#xA;    WHERE TimeKey = 2359&#xA;      AND FullTime = CAST('23:59:00' AS TIME(0))&#xA;)&#xA;    THROW 52013, N'Phạm vi giờ không đúng.', 1;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.DimCollisionSeverity&#xA;    WHERE CollisionSeverityGroup &lt;&gt;&#xA;        CASE&#xA;            WHEN CollisionSeverity IN (N'Fatal', N'Serious')&#xA;                THEN N'KSI'&#xA;            WHEN CollisionSeverity = N'Slight'&#xA;                THEN N'Non-KSI'&#xA;            ELSE N'Unknown'&#xA;        END&#xA;)&#xA;    THROW 52014, N'Nhóm Collision Severity sai.', 1;&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.DimCasualtySeverity&#xA;    WHERE CasualtySeverityGroup &lt;&gt;&#xA;        CASE&#xA;            WHEN CasualtySeverity IN (N'Fatal', N'Serious')&#xA;                THEN N'KSI'&#xA;            WHEN CasualtySeverity = N'Slight'&#xA;                THEN N'Non-KSI'&#xA;            ELSE N'Unknown'&#xA;        END&#xA;)&#xA;    THROW 52015, N'Nhóm Casualty Severity sai.', 1;&#xA;&#xA;IF EXISTS (SELECT 1 FROM dwh.FactCasualty)&#xA;    THROW 52016, N'Fact phải rỗng trước khi nạp.', 1;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:PrecedenceConstraints>
    <DTS:PrecedenceConstraint
      DTS:refId="Package.PrecedenceConstraints[Constraint]"
      DTS:CreationName=""
      DTS:DTSID="{52C3993A-9FFD-445E-ACCC-DFE903452A0C}"
      DTS:From="Package\01 - Clear Fact and Dimensions"
      DTS:LogicalAnd="True"
      DTS:ObjectName="Constraint"
      DTS:To="Package\02 - Load DimDate" />
    <DTS:PrecedenceConstraint
