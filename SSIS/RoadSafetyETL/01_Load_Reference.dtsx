    <DTS:Executable
      DTS:refId="Package\03 - Validate Data Guide Load"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{283C0E9F-D852-4969-85A0-41E83BA52696}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="03 - Validate Data Guide Load"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="DECLARE @RowsRead BIGINT = ?;&#xA;&#xA;DECLARE @RowsLoaded BIGINT =&#xA;(&#xA;    SELECT COUNT_BIG(*)&#xA;    FROM stg.DataGuideRaw&#xA;);&#xA;&#xA;IF @RowsRead = 0&#xA;BEGIN&#xA;    THROW 51001,&#xA;          N'SSIS không đọc được dòng nào từ Data Guide.',&#xA;          1;&#xA;END;&#xA;&#xA;IF @RowsRead &lt;&gt; @RowsLoaded&#xA;BEGIN&#xA;    THROW 51002,&#xA;          N'Số dòng SSIS đọc không khớp với số dòng được nạp vào stg.DataGuideRaw.',&#xA;          1;&#xA;END;&#xA;&#xA;IF @RowsLoaded &lt;&gt; 1821&#xA;BEGIN&#xA;    THROW 51003,&#xA;          N'Số dòng Data Guide không đúng với kết quả profiling mong đợi là 1821.',&#xA;          1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::v_DataGuideRowCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\04 - Build Code Lookup"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3569F820-6C9C-4B9D-BBFB-6FC8F59440C6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="04 - Build Code Lookup"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="/*==============================================================&#xA;  Tạo bảng tra cứu mã - nhãn dùng cho quá trình transform&#xA;==============================================================*/&#xA;&#xA;IF OBJECT_ID(N'stg.CodeLookup', N'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE stg.CodeLookup&#xA;    (&#xA;        CodeLookupKey INT IDENTITY(1,1) NOT NULL&#xA;            CONSTRAINT PK_CodeLookup PRIMARY KEY,&#xA;&#xA;        SourceTable NVARCHAR(100) NOT NULL,&#xA;        FieldName   NVARCHAR(200) NOT NULL,&#xA;        RawCode     NVARCHAR(200) NOT NULL,&#xA;        Label       NVARCHAR(500) NOT NULL,&#xA;        Note        NVARCHAR(2000) NULL,&#xA;&#xA;        CONSTRAINT UQ_CodeLookup&#xA;            UNIQUE (SourceTable, FieldName, RawCode)&#xA;    );&#xA;END&#xA;ELSE&#xA;BEGIN&#xA;    TRUNCATE TABLE stg.CodeLookup;&#xA;END;&#xA;&#xA;&#xA;/*==============================================================&#xA;  Chỉ lấy những dòng thực sự là mapping mã - nhãn&#xA;==============================================================*/&#xA;&#xA;INSERT INTO stg.CodeLookup&#xA;(&#xA;    SourceTable,&#xA;    FieldName,&#xA;    RawCode,&#xA;    Label,&#xA;    Note&#xA;)&#xA;SELECT DISTINCT&#xA;    LTRIM(RTRIM(SourceTable)),&#xA;    LTRIM(RTRIM(FieldName)),&#xA;    LTRIM(RTRIM(RawCode)),&#xA;    LTRIM(RTRIM(Label)),&#xA;    NULLIF(LTRIM(RTRIM(Note)), N'')&#xA;FROM stg.DataGuideRaw&#xA;WHERE NULLIF(LTRIM(RTRIM(SourceTable)), N'') IS NOT NULL&#xA;  AND NULLIF(LTRIM(RTRIM(FieldName)), N'') IS NOT NULL&#xA;  AND NULLIF(LTRIM(RTRIM(RawCode)), N'') IS NOT NULL&#xA;  AND NULLIF(LTRIM(RTRIM(Label)), N'') IS NOT NULL;&#xA;&#xA;&#xA;/*==============================================================&#xA;  Kiểm tra kết quả theo profiling&#xA;==============================================================*/&#xA;&#xA;DECLARE @MappingCount BIGINT =&#xA;(&#xA;    SELECT COUNT_BIG(*)&#xA;    FROM stg.CodeLookup&#xA;);&#xA;&#xA;IF @MappingCount &lt;&gt; 1774&#xA;BEGIN&#xA;    THROW 51004,&#xA;          N'Số mapping hợp lệ trong CodeLookup không bằng 1774.',&#xA;          1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\05 - Supplement ONS and Validate Lookup"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E1929989-4A42-4060-A8BE-38E5DECD1355}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="05 - Supplement ONS and Validate Lookup"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;------------------------------------------------------------&#xA;-- 1. Bổ sung ba mã ONS thiếu trong Data Guide&#xA;------------------------------------------------------------&#xA;INSERT INTO stg.CodeLookup&#xA;(&#xA;    SourceTable,&#xA;    FieldName,&#xA;    RawCode,&#xA;    Label,&#xA;    Note&#xA;)&#xA;SELECT&#xA;    supplement.SourceTable,&#xA;    supplement.FieldName,&#xA;    supplement.RawCode,&#xA;    supplement.Label,&#xA;    supplement.Note&#xA;FROM&#xA;(&#xA;    VALUES&#xA;    (&#xA;        N'collision',&#xA;        N'local_authority_ons_district',&#xA;        N'E07000246',&#xA;        N'Somerset West and Taunton',&#xA;        N'Bổ sung từ nguồn ONS chính thức; đơn vị lịch sử được thay thế bởi Somerset từ năm 2023.'&#xA;    ),&#xA;    (&#xA;        N'collision',&#xA;        N'local_authority_ons_district',&#xA;        N'E08000038',&#xA;        N'Barnsley',&#xA;        N'Bổ sung từ nguồn ONS chính thức; mã mới thay thế E08000016 từ năm 2025 do thay đổi địa giới.'&#xA;    ),&#xA;    (&#xA;        N'collision',&#xA;        N'local_authority_ons_district',&#xA;        N'E08000039',&#xA;        N'Sheffield',&#xA;        N'Bổ sung từ nguồn ONS chính thức; mã mới thay thế E08000019 từ năm 2025 do thay đổi địa giới.'&#xA;    )&#xA;) AS supplement&#xA;(&#xA;    SourceTable,&#xA;    FieldName,&#xA;    RawCode,&#xA;    Label,&#xA;    Note&#xA;)&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM stg.CodeLookup AS existing&#xA;    WHERE existing.SourceTable = supplement.SourceTable&#xA;      AND existing.FieldName = supplement.FieldName&#xA;      AND existing.RawCode = supplement.RawCode&#xA;);&#xA;&#xA;------------------------------------------------------------&#xA;-- 2. Kiểm tra không trùng khóa mapping&#xA;------------------------------------------------------------&#xA;IF EXISTS&#xA;(&#xA;    SELECT&#xA;        SourceTable,&#xA;        FieldName,&#xA;        RawCode&#xA;    FROM stg.CodeLookup&#xA;    GROUP BY&#xA;        SourceTable,&#xA;        FieldName,&#xA;        RawCode&#xA;    HAVING COUNT(*) &gt; 1&#xA;)&#xA;BEGIN&#xA;    THROW 51001,&#xA;          N'CodeLookup có mapping bị trùng khóa.',&#xA;          1;&#xA;END;&#xA;&#xA;------------------------------------------------------------&#xA;-- 3. Kiểm tra đúng ba mapping ONS bổ sung&#xA;------------------------------------------------------------&#xA;IF&#xA;(&#xA;    SELECT COUNT(*)&#xA;    FROM stg.CodeLookup&#xA;    WHERE SourceTable = N'collision'&#xA;      AND FieldName = N'local_authority_ons_district'&#xA;      AND&#xA;      (&#xA;          (RawCode = N'E07000246'&#xA;           AND Label = N'Somerset West and Taunton')&#xA;&#xA;          OR&#xA;&#xA;          (RawCode = N'E08000038'&#xA;           AND Label = N'Barnsley')&#xA;&#xA;          OR&#xA;&#xA;          (RawCode = N'E08000039'&#xA;           AND Label = N'Sheffield')&#xA;      )&#xA;) &lt;&gt; 3&#xA;BEGIN&#xA;    THROW 51002,&#xA;          N'Ba mapping ONS bổ sung không đầy đủ hoặc sai label.',&#xA;          1;&#xA;END;&#xA;&#xA;------------------------------------------------------------&#xA;-- 4. Kiểm tra tổng số mapping&#xA;------------------------------------------------------------&#xA;IF&#xA;(&#xA;    SELECT COUNT(*)&#xA;    FROM stg.CodeLookup&#xA;) &lt;&gt; 1777&#xA;BEGIN&#xA;    THROW 51003,&#xA;          N'Tổng số mapping trong CodeLookup không bằng 1777.',&#xA;          1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
