          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(N'stg.DataGuideRaw', N'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE stg.DataGuideRaw&#xA;    (&#xA;        DataGuideRawKey INT IDENTITY(1,1) NOT NULL&#xA;            CONSTRAINT PK_DataGuideRaw PRIMARY KEY,&#xA;&#xA;        SourceTable NVARCHAR(100) NULL,&#xA;        FieldName NVARCHAR(200) NULL,&#xA;        RawCode NVARCHAR(200) NULL,&#xA;        Label NVARCHAR(500) NULL,&#xA;        Note NVARCHAR(2000) NULL&#xA;    );&#xA;END;&#xA;&#xA;TRUNCATE TABLE stg.DataGuideRaw;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
