      DTS:DTSID="{0BD98CE8-B0BC-4E6A-95B7-EAC94745C91D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="05 - Validate Staging"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;DECLARE @CollisionRows BIGINT;&#xA;DECLARE @VehicleRows BIGINT;&#xA;DECLARE @CasualtyRows BIGINT;&#xA;DECLARE @ErrorMessage NVARCHAR(2048);&#xA;&#xA;SELECT @CollisionRows = COUNT_BIG(*)&#xA;FROM stg.Collisions;&#xA;&#xA;SELECT @VehicleRows = COUNT_BIG(*)&#xA;FROM stg.Vehicles;&#xA;&#xA;SELECT @CasualtyRows = COUNT_BIG(*)&#xA;FROM stg.Casualties;&#xA;&#xA;IF&#xA;(&#xA;       @CollisionRows &lt;&gt; 513801&#xA;    OR @VehicleRows   &lt;&gt; 937265&#xA;    OR @CasualtyRows  &lt;&gt; 652821&#xA;)&#xA;BEGIN&#xA;    SET @ErrorMessage = CONCAT(&#xA;        N'Số dòng staging không đúng. ',&#xA;        N'Collisions = ', @CollisionRows,&#xA;        N'; Vehicles = ', @VehicleRows,&#xA;        N'; Casualties = ', @CasualtyRows&#xA;    );&#xA;&#xA;    THROW 51001, @ErrorMessage, 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
