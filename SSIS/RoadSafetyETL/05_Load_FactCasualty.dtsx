              refId="Package\02 - Load FactCasualty\SRC - FactCasualty Rows"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC - FactCasualty Rows"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    D.DateKey,
    T.TimeKey,
    L.LocationKey,
    R.RoadKey,
    J.JunctionKey,
    E.EnvironmentKey,
    CollisionSeverityDim.CollisionSeverityKey,
    VehicleDim.VehicleKey,
    DriverDim.DriverKey,
    CasualtyDim.CasualtyKey,
    CasualtySeverityDim.CasualtySeverityKey,

    C.collision_index AS CollisionIndex,
    CA.vehicle_reference AS VehicleReference,
    CA.casualty_reference AS CasualtyReference,

    CAST(
        CONCAT(
            CA.collision_index,
            '-',
            CA.vehicle_reference
        )
        AS VARCHAR(100)
    ) AS VehicleInvolvementID,

    TRY_CONVERT(
        DECIMAL(9,6),
        C.longitude
    ) AS Longitude,

    TRY_CONVERT(
        DECIMAL(9,6),
        C.latitude
    ) AS Latitude,

    CAST(1 AS TINYINT) AS CasualtyCount,

    CAST(
        CASE
            WHEN CA.casualty_severity IN
                 (N'Fatal', N'Serious')
            THEN 1
            ELSE 0
        END
        AS TINYINT
    ) AS KSICasualtyCount

FROM stg.Casualties AS CA

/* Mỗi casualty thuộc một collision */
INNER JOIN stg.Collisions AS C
    ON C.collision_index = CA.collision_index

/* Tìm vehicle mà casualty tham chiếu */
INNER JOIN stg.Vehicles AS V
    ON  V.collision_index = CA.collision_index
    AND V.vehicle_reference = CA.vehicle_reference

/* Tra khóa ngày */
INNER JOIN dwh.DimDate AS D
    ON D.FullDate = TRY_CONVERT(
        DATE,
        C.[date]
    )

/* Tra khóa thời gian */
INNER JOIN dwh.DimTime AS T
    ON T.FullTime = TRY_CONVERT(
        TIME(0),
        C.[time]
    )

/* Tra khóa địa phương */
INNER JOIN dwh.DimLocation AS L
    ON L.LocalAuthorityCode =
       C.local_authority_ons_district

/* Tra khóa đặc điểm đường */
INNER JOIN dwh.DimRoad AS R
    ON  R.FirstRoadClass =
        C.first_road_class

    AND R.RoadType =
        C.road_type

    AND ISNULL(R.SpeedLimit, -32768) =
        ISNULL(
            TRY_CONVERT(
                SMALLINT,
                NULLIF(
                    LTRIM(
                        RTRIM(
                            CONVERT(
                                VARCHAR(20),
                                C.speed_limit
                            )
                        )
                    ),
                    ''
                )
            ),
            -32768
        )

    AND R.UrbanOrRuralArea =
        C.urban_or_rural_area

/* Tra khóa đặc điểm nút giao */
INNER JOIN dwh.DimJunction AS J
    ON  J.JunctionDetail =
        C.junction_detail

    AND J.JunctionControl =
        C.junction_control

    AND J.PedestrianCrossing =
        C.pedestrian_crossing

/* Tra khóa điều kiện môi trường */
INNER JOIN dwh.DimEnvironment AS E
    ON  E.LightConditions =
        C.light_conditions

    AND E.WeatherConditions =
        C.weather_conditions

    AND E.RoadSurfaceConditions =
        C.road_surface_conditions

/* Tra mức độ nghiêm trọng của collision */
INNER JOIN dwh.DimCollisionSeverity
    AS CollisionSeverityDim
    ON CollisionSeverityDim.CollisionSeverity =
       C.collision_severity

/* Tra đặc điểm phương tiện */
INNER JOIN dwh.DimVehicle AS VehicleDim
    ON  VehicleDim.VehicleType =
        V.vehicle_type

    AND VehicleDim.VehicleManoeuvre =
        V.vehicle_manoeuvre

    AND VehicleDim.SkiddingAndOverturning =
        V.skidding_and_overturning

    AND VehicleDim.VehicleLeavingCarriageway =
        V.vehicle_leaving_carriageway

/* Tra đặc điểm người điều khiển */
INNER JOIN dwh.DimDriver AS DriverDim
    ON  DriverDim.SexOfDriver =
        V.sex_of_driver

    AND DriverDim.AgeBandOfDriver =
        V.age_band_of_driver

/* Tra đặc điểm casualty */
INNER JOIN dwh.DimCasualty AS CasualtyDim
    ON  CasualtyDim.CasualtyClass =
        CA.casualty_class

    AND CasualtyDim.SexOfCasualty =
        CA.sex_of_casualty

    AND CasualtyDim.AgeBandOfCasualty =
        CA.age_band_of_casualty

    AND CasualtyDim.CasualtyType =
        CA.casualty_type

/* Tra mức độ thương tích của casualty */
INNER JOIN dwh.DimCasualtySeverity
    AS CasualtySeverityDim
    ON CasualtySeverityDim.CasualtySeverity =
       CA.casualty_severity;</property>
