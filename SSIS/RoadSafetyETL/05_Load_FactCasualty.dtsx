    <DTS:Executable
      DTS:refId="Package\03 - Validate FactCasualty"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0E40CBD6-9B36-4A82-875D-F2E4472E6DD2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="03 - Validate FactCasualty"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;DECLARE @SSISRowCount BIGINT = ?;&#xA;DECLARE @FactRowCount BIGINT;&#xA;DECLARE @CollisionCount BIGINT;&#xA;DECLARE @VehicleCount BIGINT;&#xA;DECLARE @ExpectedKSICount BIGINT;&#xA;DECLARE @ActualKSICount BIGINT;&#xA;&#xA;&#xA;/* 1. Lấy các chỉ số thực tế từ Fact */&#xA;SELECT&#xA;    @FactRowCount = COUNT_BIG(*)&#xA;FROM dwh.FactCasualty;&#xA;&#xA;SELECT&#xA;    @CollisionCount = COUNT_BIG(*)&#xA;FROM&#xA;(&#xA;    SELECT CollisionIndex&#xA;    FROM dwh.FactCasualty&#xA;    GROUP BY CollisionIndex&#xA;) AS DistinctCollisions;&#xA;&#xA;SELECT&#xA;    @VehicleCount = COUNT_BIG(*)&#xA;FROM&#xA;(&#xA;    SELECT VehicleInvolvementID&#xA;    FROM dwh.FactCasualty&#xA;    GROUP BY VehicleInvolvementID&#xA;) AS DistinctVehicles;&#xA;&#xA;&#xA;/* 2. Kiểm tra số dòng đi qua SSIS */&#xA;IF @SSISRowCount &lt;&gt; 652821&#xA;BEGIN&#xA;    THROW 54001,&#xA;          N'Row Count của SSIS không bằng 652.821.',&#xA;          1;&#xA;END;&#xA;&#xA;&#xA;/* 3. Kiểm tra số dòng thực tế đã ghi vào Fact */&#xA;IF @FactRowCount &lt;&gt; 652821&#xA;BEGIN&#xA;    THROW 54002,&#xA;          N'FactCasualty không có đúng 652.821 dòng.',&#xA;          1;&#xA;END;&#xA;&#xA;&#xA;/* 4. Row Count của SSIS phải bằng số dòng trong Fact */&#xA;IF @SSISRowCount &lt;&gt; @FactRowCount&#xA;BEGIN&#xA;    THROW 54003,&#xA;          N'Số dòng đi qua SSIS khác số dòng được ghi vào Fact.',&#xA;          1;&#xA;END;&#xA;&#xA;&#xA;/* 5. Kiểm tra số collision phân biệt */&#xA;IF @CollisionCount &lt;&gt; 513801&#xA;BEGIN&#xA;    THROW 54004,&#xA;          N'FactCasualty không có đúng 513.801 collision phân biệt.',&#xA;          1;&#xA;END;&#xA;&#xA;&#xA;/* 6. Kiểm tra số vehicle gắn với casualty */&#xA;IF @VehicleCount &lt;&gt; 566945&#xA;BEGIN&#xA;    THROW 54005,&#xA;          N'FactCasualty không có đúng 566.945 vehicle phân biệt.',&#xA;          1;&#xA;END;&#xA;&#xA;&#xA;/* 7. Kiểm tra grain của Fact */&#xA;IF EXISTS&#xA;(&#xA;    SELECT&#xA;        CollisionIndex,&#xA;        CasualtyReference&#xA;    FROM dwh.FactCasualty&#xA;    GROUP BY&#xA;        CollisionIndex,&#xA;        CasualtyReference&#xA;    HAVING COUNT_BIG(*) &gt; 1&#xA;)&#xA;BEGIN&#xA;    THROW 54006,&#xA;          N'FactCasualty bị trùng natural key.',&#xA;          1;&#xA;END;&#xA;&#xA;&#xA;/* 8. Kiểm tra các Dimension Key */&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactCasualty&#xA;    WHERE&#xA;           DateKey IS NULL&#xA;        OR TimeKey IS NULL&#xA;        OR LocationKey IS NULL&#xA;        OR RoadKey IS NULL&#xA;        OR JunctionKey IS NULL&#xA;        OR EnvironmentKey IS NULL&#xA;        OR CollisionSeverityKey IS NULL&#xA;        OR VehicleKey IS NULL&#xA;        OR DriverKey IS NULL&#xA;        OR CasualtyKey IS NULL&#xA;        OR CasualtySeverityKey IS NULL&#xA;)&#xA;BEGIN&#xA;    THROW 54007,&#xA;          N'FactCasualty có Dimension Key bị NULL.',&#xA;          1;&#xA;END;&#xA;&#xA;&#xA;/* 9. CasualtyCount phải luôn bằng 1 */&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactCasualty&#xA;    WHERE CasualtyCount &lt;&gt; 1&#xA;       OR CasualtyCount IS NULL&#xA;)&#xA;BEGIN&#xA;    THROW 54008,&#xA;          N'CasualtyCount có giá trị không hợp lệ.',&#xA;          1;&#xA;END;&#xA;&#xA;&#xA;/* 10. KSICasualtyCount chỉ được bằng 0 hoặc 1 */&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactCasualty&#xA;    WHERE KSICasualtyCount NOT IN (0, 1)&#xA;       OR KSICasualtyCount IS NULL&#xA;)&#xA;BEGIN&#xA;    THROW 54009,&#xA;          N'KSICasualtyCount có giá trị không hợp lệ.',&#xA;          1;&#xA;END;&#xA;&#xA;&#xA;/* 11. Đối soát số casualty KSI với staging */&#xA;SELECT&#xA;    @ExpectedKSICount =&#xA;        SUM(&#xA;            CASE&#xA;                WHEN casualty_severity&#xA;                     IN (N'Fatal', N'Serious')&#xA;                THEN 1&#xA;                ELSE 0&#xA;            END&#xA;        )&#xA;FROM stg.Casualties;&#xA;&#xA;SELECT&#xA;    @ActualKSICount =&#xA;        SUM(CONVERT(BIGINT, KSICasualtyCount))&#xA;FROM dwh.FactCasualty;&#xA;&#xA;IF @ExpectedKSICount &lt;&gt; @ActualKSICount&#xA;BEGIN&#xA;    THROW 54010,&#xA;          N'Số casualty KSI trong Fact không khớp staging.',&#xA;          1;&#xA;END;&#xA;&#xA;&#xA;/* 12. Longitude và Latitude phải thiếu theo cặp */&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.FactCasualty&#xA;    WHERE&#xA;           (Longitude IS NULL AND Latitude IS NOT NULL)&#xA;        OR (Longitude IS NOT NULL AND Latitude IS NULL)&#xA;)&#xA;BEGIN&#xA;    THROW 54011,&#xA;          N'Longitude và Latitude không thiếu theo cặp.',&#xA;          1;&#xA;END;&#xA;&#xA;&#xA;/* 13. Phải có đúng 53 collision thiếu tọa độ */&#xA;IF&#xA;(&#xA;    SELECT COUNT_BIG(*)&#xA;    FROM&#xA;    (&#xA;        SELECT CollisionIndex&#xA;        FROM dwh.FactCasualty&#xA;        WHERE Longitude IS NULL&#xA;          AND Latitude IS NULL&#xA;        GROUP BY CollisionIndex&#xA;    ) AS MissingCoordinateCollisions&#xA;) &lt;&gt; 53&#xA;BEGIN&#xA;    THROW 54012,&#xA;          N'Số collision thiếu tọa độ không bằng 53.',&#xA;          1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::v_FactCasualtyRowCount"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
