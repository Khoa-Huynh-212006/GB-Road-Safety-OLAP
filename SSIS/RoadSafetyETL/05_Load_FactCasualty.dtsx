    <DTS:Executable
      DTS:refId="Package\01 - Validate Fact Sources"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DEC936D4-CA0F-48EB-B356-1DAED6E4D844}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="01 - Validate Fact Sources"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;/* 1. Kiểm tra số dòng của ba bảng staging */&#xA;IF (SELECT COUNT_BIG(*) FROM stg.Collisions) &lt;&gt; 513801&#xA;BEGIN&#xA;    THROW 53001, N'stg.Collisions không có đúng 513.801 dòng.', 1;&#xA;END;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM stg.Vehicles) &lt;&gt; 937265&#xA;BEGIN&#xA;    THROW 53002, N'stg.Vehicles không có đúng 937.265 dòng.', 1;&#xA;END;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM stg.Casualties) &lt;&gt; 652821&#xA;BEGIN&#xA;    THROW 53003, N'stg.Casualties không có đúng 652.821 dòng.', 1;&#xA;END;&#xA;&#xA;&#xA;/* 2. Kiểm tra các Dimension đã được nạp */&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimDate)&#xA;    THROW 53004, N'DimDate chưa có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimTime)&#xA;    THROW 53005, N'DimTime chưa có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimLocation)&#xA;    THROW 53006, N'DimLocation chưa có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimRoad)&#xA;    THROW 53007, N'DimRoad chưa có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimJunction)&#xA;    THROW 53008, N'DimJunction chưa có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimEnvironment)&#xA;    THROW 53009, N'DimEnvironment chưa có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimVehicle)&#xA;    THROW 53010, N'DimVehicle chưa có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimDriver)&#xA;    THROW 53011, N'DimDriver chưa có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimCasualty)&#xA;    THROW 53012, N'DimCasualty chưa có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimCollisionSeverity)&#xA;    THROW 53013, N'DimCollisionSeverity chưa có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimCasualtySeverity)&#xA;    THROW 53014, N'DimCasualtySeverity chưa có dữ liệu.', 1;&#xA;&#xA;&#xA;/* 3. Fact phải đang rỗng trước khi nạp mới */&#xA;IF EXISTS (SELECT 1 FROM dwh.FactCasualty)&#xA;BEGIN&#xA;    THROW 53015, N'FactCasualty không rỗng trước khi nạp dữ liệu.', 1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
