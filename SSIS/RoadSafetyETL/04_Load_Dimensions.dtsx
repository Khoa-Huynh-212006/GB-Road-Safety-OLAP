  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\01 - Clear Fact and Dimensions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{62FB413E-8478-4354-A9D2-6F66992077AE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="01 - Clear Fact and Dimensions"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    ------------------------------------------------------------&#xA;    -- Xóa Fact trước vì Fact đang tham chiếu các Dimension&#xA;    ------------------------------------------------------------&#xA;&#xA;    TRUNCATE TABLE dwh.FactCasualty;&#xA;&#xA;    ------------------------------------------------------------&#xA;    -- Xóa dữ liệu Dimension&#xA;    -- Không dùng TRUNCATE vì các bảng đang được Foreign Key&#xA;    -- của FactCasualty tham chiếu&#xA;    ------------------------------------------------------------&#xA;&#xA;    DELETE FROM dwh.DimCasualtySeverity;&#xA;    DELETE FROM dwh.DimCollisionSeverity;&#xA;    DELETE FROM dwh.DimCasualty;&#xA;    DELETE FROM dwh.DimDriver;&#xA;    DELETE FROM dwh.DimVehicle;&#xA;    DELETE FROM dwh.DimEnvironment;&#xA;    DELETE FROM dwh.DimJunction;&#xA;    DELETE FROM dwh.DimRoad;&#xA;    DELETE FROM dwh.DimLocation;&#xA;    DELETE FROM dwh.DimTime;&#xA;    DELETE FROM dwh.DimDate;&#xA;&#xA;    ------------------------------------------------------------&#xA;    -- Đặt lại các khóa tự tăng&#xA;    ------------------------------------------------------------&#xA;&#xA;    DBCC CHECKIDENT ('dwh.DimLocation', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimRoad', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimJunction', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimEnvironment', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimVehicle', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimDriver', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimCasualty', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimCollisionSeverity', RESEED, 0);&#xA;    DBCC CHECKIDENT ('dwh.DimCasualtySeverity', RESEED, 0);&#xA;&#xA;    COMMIT TRANSACTION;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\02 - Load DimDate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1013B204-CBFF-4D4A-89BB-DAAB098C2AC6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="02 - Load DimDate"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET LANGUAGE us_english;&#xA;SET DATEFIRST 1;&#xA;&#xA;DECLARE @StartDate DATE = DATEFROMPARTS(2021, 1, 1);&#xA;DECLARE @EndDate   DATE = DATEFROMPARTS(2025, 12, 31);&#xA;&#xA;;WITH DateSeries AS&#xA;(&#xA;    SELECT @StartDate AS FullDate&#xA;&#xA;    UNION ALL&#xA;&#xA;    SELECT DATEADD(DAY, 1, FullDate)&#xA;    FROM DateSeries&#xA;    WHERE FullDate &lt; @EndDate&#xA;)&#xA;INSERT INTO dwh.DimDate&#xA;(&#xA;    DateKey,&#xA;    FullDate,&#xA;    [Day],&#xA;    MonthNumber,&#xA;    MonthName,&#xA;    [Quarter],&#xA;    [Year],&#xA;    DayOfWeekNumber,&#xA;    DayOfWeekName,&#xA;    IsWeekend&#xA;)&#xA;SELECT&#xA;    CONVERT(&#xA;        INT,&#xA;        CONVERT(CHAR(8), FullDate, 112)&#xA;    ) AS DateKey,&#xA;&#xA;    FullDate,&#xA;&#xA;    DATEPART(DAY, FullDate) AS [Day],&#xA;&#xA;    DATEPART(MONTH, FullDate) AS MonthNumber,&#xA;&#xA;    DATENAME(MONTH, FullDate) AS MonthName,&#xA;&#xA;    DATEPART(QUARTER, FullDate) AS [Quarter],&#xA;&#xA;    DATEPART(YEAR, FullDate) AS [Year],&#xA;&#xA;    DATEPART(WEEKDAY, FullDate) AS DayOfWeekNumber,&#xA;&#xA;    DATENAME(WEEKDAY, FullDate) AS DayOfWeekName,&#xA;&#xA;    CASE&#xA;        WHEN DATEPART(WEEKDAY, FullDate) IN (6, 7)&#xA;            THEN CAST(1 AS BIT)&#xA;        ELSE CAST(0 AS BIT)&#xA;    END AS IsWeekend&#xA;&#xA;FROM DateSeries&#xA;OPTION (MAXRECURSION 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\03 - Load DimTime"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{23F69403-04F7-44F9-BD5A-E97F4BD2B8E6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="03 - Load DimTime"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;;WITH MinuteSeries AS&#xA;(&#xA;    SELECT 0 AS MinuteOfDay&#xA;&#xA;    UNION ALL&#xA;&#xA;    SELECT MinuteOfDay + 1&#xA;    FROM MinuteSeries&#xA;    WHERE MinuteOfDay &lt; 1439&#xA;)&#xA;INSERT INTO dwh.DimTime&#xA;(&#xA;    TimeKey,&#xA;    FullTime,&#xA;    [Hour],&#xA;    [Minute],&#xA;    TimeBand&#xA;)&#xA;SELECT&#xA;    ((MinuteOfDay / 60) * 100)&#xA;        + (MinuteOfDay % 60) AS TimeKey,&#xA;&#xA;    TIMEFROMPARTS&#xA;    (&#xA;        MinuteOfDay / 60,&#xA;        MinuteOfDay % 60,&#xA;        0,&#xA;        0,&#xA;        0&#xA;    ) AS FullTime,&#xA;&#xA;    MinuteOfDay / 60 AS [Hour],&#xA;&#xA;    MinuteOfDay % 60 AS [Minute],&#xA;&#xA;    CASE&#xA;        WHEN MinuteOfDay / 60 BETWEEN 0 AND 5&#xA;            THEN N'Night'&#xA;&#xA;        WHEN MinuteOfDay / 60 BETWEEN 6 AND 11&#xA;            THEN N'Morning'&#xA;&#xA;        WHEN MinuteOfDay / 60 BETWEEN 12 AND 17&#xA;            THEN N'Afternoon'&#xA;&#xA;        ELSE N'Evening'&#xA;    END AS TimeBand&#xA;&#xA;FROM MinuteSeries&#xA;OPTION (MAXRECURSION 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\04 - Load DimLocation"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{EC129BDE-FD42-4DB8-8D6E-83A2D22B4CC7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="04 - Load DimLocation"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimLocation&#xA;(&#xA;    LocalAuthorityCode,&#xA;    LocalAuthorityName&#xA;)&#xA;SELECT DISTINCT&#xA;    local_authority_ons_district,&#xA;    local_authority_ons_district_name&#xA;FROM stg.Collisions;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\05 - Load DimRoad"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FD5BEF06-AB3A-4A94-BBAB-3850F0EBA1F0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="05 - Load DimRoad"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;;WITH RoadSource AS&#xA;(&#xA;    SELECT&#xA;        first_road_class AS FirstRoadClass,&#xA;        road_type AS RoadType,&#xA;&#xA;        TRY_CONVERT&#xA;        (&#xA;            SMALLINT,&#xA;            NULLIF&#xA;            (&#xA;                LTRIM(RTRIM(speed_limit)),&#xA;                ''&#xA;            )&#xA;        ) AS SpeedLimit,&#xA;&#xA;        urban_or_rural_area AS UrbanOrRuralArea&#xA;    FROM stg.Collisions&#xA;)&#xA;INSERT INTO dwh.DimRoad&#xA;(&#xA;    FirstRoadClass,&#xA;    RoadType,&#xA;    SpeedLimit,&#xA;    UrbanOrRuralArea&#xA;)&#xA;SELECT DISTINCT&#xA;    FirstRoadClass,&#xA;    RoadType,&#xA;    SpeedLimit,&#xA;    UrbanOrRuralArea&#xA;FROM RoadSource;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\06 - Load DimJunction"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0BA9070B-06E9-4FEC-BF74-2E9FFABAAAF7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="06 - Load DimJunction"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimJunction&#xA;(&#xA;    JunctionDetail,&#xA;    JunctionControl,&#xA;    PedestrianCrossing&#xA;)&#xA;SELECT DISTINCT&#xA;    junction_detail,&#xA;    junction_control,&#xA;    pedestrian_crossing&#xA;FROM stg.Collisions;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\07 - Load DimEnvironment"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3D023DC6-4A67-4DE6-A670-C6ADDCC8D94D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="07 - Load DimEnvironment"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimEnvironment&#xA;(&#xA;    LightConditions,&#xA;    WeatherConditions,&#xA;    RoadSurfaceConditions&#xA;)&#xA;SELECT DISTINCT&#xA;    light_conditions,&#xA;    weather_conditions,&#xA;    road_surface_conditions&#xA;FROM stg.Collisions;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\08 - Load DimVehicle"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D359BF05-C65E-4747-8489-2A586AAF0C21}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="08 - Load DimVehicle"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimVehicle&#xA;(&#xA;    VehicleType,&#xA;    VehicleManoeuvre,&#xA;    SkiddingAndOverturning,&#xA;    VehicleLeavingCarriageway&#xA;)&#xA;SELECT DISTINCT&#xA;    V.vehicle_type,&#xA;    V.vehicle_manoeuvre,&#xA;    V.skidding_and_overturning,&#xA;    V.vehicle_leaving_carriageway&#xA;FROM stg.Vehicles AS V&#xA;INNER JOIN stg.Casualties AS C&#xA;    ON  C.collision_index = V.collision_index&#xA;    AND C.vehicle_reference = V.vehicle_reference;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\09 - Load DimDriver"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{04311858-CE31-404E-92D9-EA82C08BEBCA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="09 - Load DimDriver"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimDriver&#xA;(&#xA;    SexOfDriver,&#xA;    AgeBandOfDriver&#xA;)&#xA;SELECT DISTINCT&#xA;    V.sex_of_driver,&#xA;    V.age_band_of_driver&#xA;FROM stg.Vehicles AS V&#xA;INNER JOIN stg.Casualties AS C&#xA;    ON  C.collision_index = V.collision_index&#xA;    AND C.vehicle_reference = V.vehicle_reference;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\10 - Load DimCasualty"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{BB4E2859-0294-41DA-9C15-01E3FE773CEC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="10 - Load DimCasualty"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimCasualty&#xA;(&#xA;    CasualtyClass,&#xA;    SexOfCasualty,&#xA;    AgeBandOfCasualty,&#xA;    CasualtyType&#xA;)&#xA;SELECT DISTINCT&#xA;    casualty_class,&#xA;    sex_of_casualty,&#xA;    age_band_of_casualty,&#xA;    casualty_type&#xA;FROM stg.Casualties;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\11 - Load DimCollisionSeverity"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8A8199AF-AE96-46AC-BA6D-611D193B800E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="11 - Load DimCollisionSeverity"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimCollisionSeverity&#xA;(&#xA;    CollisionSeverity,&#xA;    CollisionSeverityGroup&#xA;)&#xA;SELECT DISTINCT&#xA;    collision_severity,&#xA;&#xA;    CASE&#xA;        WHEN collision_severity IN&#xA;        (&#xA;            N'Fatal',&#xA;            N'Serious'&#xA;        )&#xA;            THEN N'KSI'&#xA;&#xA;        WHEN collision_severity = N'Slight'&#xA;            THEN N'Non-KSI'&#xA;&#xA;        ELSE N'Unknown'&#xA;    END AS CollisionSeverityGroup&#xA;&#xA;FROM stg.Collisions;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\12 - Load DimCasualtySeverity"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{23DE5EA8-061D-4D30-9DF0-921FBC86E488}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="12 - Load DimCasualtySeverity"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dwh.DimCasualtySeverity&#xA;(&#xA;    CasualtySeverity,&#xA;    CasualtySeverityGroup&#xA;)&#xA;SELECT DISTINCT&#xA;    casualty_severity,&#xA;&#xA;    CASE&#xA;        WHEN casualty_severity IN&#xA;        (&#xA;            N'Fatal',&#xA;            N'Serious'&#xA;        )&#xA;            THEN N'KSI'&#xA;&#xA;        WHEN casualty_severity = N'Slight'&#xA;            THEN N'Non-KSI'&#xA;&#xA;        ELSE N'Unknown'&#xA;    END AS CasualtySeverityGroup&#xA;&#xA;FROM stg.Casualties;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\13 - Validate Dimensions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{67528B3B-B45D-4A74-BB42-2D482F77F72E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="13 - Validate Dimensions"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F05086EA-55A1-4B00-BD44-1090AAD7929D}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;------------------------------------------------------------&#xA;-- 1. Kiểm tra các Dimension có số dòng cố định&#xA;------------------------------------------------------------&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM dwh.DimDate) &lt;&gt; 1826&#xA;    THROW 52001, N'DimDate không có đúng 1.826 dòng.', 1;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM dwh.DimTime) &lt;&gt; 1440&#xA;    THROW 52002, N'DimTime không có đúng 1.440 dòng.', 1;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM dwh.DimLocation) &lt;&gt; 370&#xA;    THROW 52003, N'DimLocation không có đúng 370 dòng.', 1;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM dwh.DimCollisionSeverity) &lt;&gt; 3&#xA;    THROW 52004, N'DimCollisionSeverity không có đúng 3 dòng.', 1;&#xA;&#xA;IF (SELECT COUNT_BIG(*) FROM dwh.DimCasualtySeverity) &lt;&gt; 3&#xA;    THROW 52005, N'DimCasualtySeverity không có đúng 3 dòng.', 1;&#xA;&#xA;------------------------------------------------------------&#xA;-- 2. Kiểm tra các Dimension tổ hợp không bị rỗng&#xA;------------------------------------------------------------&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimRoad)&#xA;    THROW 52006, N'DimRoad không có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimJunction)&#xA;    THROW 52007, N'DimJunction không có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimEnvironment)&#xA;    THROW 52008, N'DimEnvironment không có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimVehicle)&#xA;    THROW 52009, N'DimVehicle không có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimDriver)&#xA;    THROW 52010, N'DimDriver không có dữ liệu.', 1;&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dwh.DimCasualty)&#xA;    THROW 52011, N'DimCasualty không có dữ liệu.', 1;&#xA;&#xA;------------------------------------------------------------&#xA;-- 3. Kiểm tra phạm vi DimDate&#xA;------------------------------------------------------------&#xA;&#xA;IF&#xA;(&#xA;       (SELECT MIN(FullDate) FROM dwh.DimDate) &lt;&gt; DATEFROMPARTS(2021, 1, 1)&#xA;    OR (SELECT MAX(FullDate) FROM dwh.DimDate) &lt;&gt; DATEFROMPARTS(2025, 12, 31)&#xA;)&#xA;BEGIN&#xA;    THROW 52012,&#xA;          N'Phạm vi ngày của DimDate không đúng 2021-2025.',&#xA;          1;&#xA;END;&#xA;&#xA;------------------------------------------------------------&#xA;-- 4. Kiểm tra phạm vi DimTime&#xA;------------------------------------------------------------&#xA;&#xA;IF&#xA;(&#xA;       NOT EXISTS&#xA;       (&#xA;           SELECT 1&#xA;           FROM dwh.DimTime&#xA;           WHERE TimeKey = 0&#xA;             AND FullTime = CAST('00:00:00' AS TIME(0))&#xA;       )&#xA;    OR NOT EXISTS&#xA;       (&#xA;           SELECT 1&#xA;           FROM dwh.DimTime&#xA;           WHERE TimeKey = 2359&#xA;             AND FullTime = CAST('23:59:00' AS TIME(0))&#xA;       )&#xA;)&#xA;BEGIN&#xA;    THROW 52013,&#xA;          N'Phạm vi thời gian của DimTime không đúng.',&#xA;          1;&#xA;END;&#xA;&#xA;------------------------------------------------------------&#xA;-- 5. Kiểm tra quy tắc phân nhóm Collision Severity&#xA;------------------------------------------------------------&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.DimCollisionSeverity&#xA;    WHERE&#xA;           (&#xA;               CollisionSeverity IN (N'Fatal', N'Serious')&#xA;               AND CollisionSeverityGroup &lt;&gt; N'KSI'&#xA;           )&#xA;        OR (&#xA;               CollisionSeverity = N'Slight'&#xA;               AND CollisionSeverityGroup &lt;&gt; N'Non-KSI'&#xA;           )&#xA;)&#xA;BEGIN&#xA;    THROW 52014,&#xA;          N'CollisionSeverityGroup được phân loại không đúng.',&#xA;          1;&#xA;END;&#xA;&#xA;------------------------------------------------------------&#xA;-- 6. Kiểm tra quy tắc phân nhóm Casualty Severity&#xA;------------------------------------------------------------&#xA;&#xA;IF EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dwh.DimCasualtySeverity&#xA;    WHERE&#xA;           (&#xA;               CasualtySeverity IN (N'Fatal', N'Serious')&#xA;               AND CasualtySeverityGroup &lt;&gt; N'KSI'&#xA;           )&#xA;        OR (&#xA;               CasualtySeverity = N'Slight'&#xA;               AND CasualtySeverityGroup &lt;&gt; N'Non-KSI'&#xA;           )&#xA;)&#xA;BEGIN&#xA;    THROW 52015,&#xA;          N'CasualtySeverityGroup được phân loại không đúng.',&#xA;          1;&#xA;END;&#xA;&#xA;------------------------------------------------------------&#xA;-- 7. Fact phải đang rỗng&#xA;------------------------------------------------------------&#xA;&#xA;IF EXISTS (SELECT 1 FROM dwh.FactCasualty)&#xA;BEGIN&#xA;    THROW 52016,&#xA;          N'FactCasualty phải rỗng trước khi chạy package nạp Fact.',&#xA;          1;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
